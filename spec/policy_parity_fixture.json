{
  "description": "POLICY_V1.md §22.7 OpenSearch scenario — parity across bindings. Every runner (Rust reference / Python / TypeScript / Go / WASM / C FFI) loads this file, seeds the same policies, and must produce the same Decision.kind plus matched_policy handle for each proposal. Timestamps are pinned so 'not-yet-active' semantics are deterministic across time zones and test clocks.",
  "prefix": "/policies",
  "agent_id": "parity-runner",
  "ref": "main",
  "policies": [
    {
      "path": "change-control/high-cost-change",
      "version": 1,
      "situation": "Any change requiring downtime, migration, or destructive operations",
      "situation_selector": { "kind": "eq", "key": "kind", "value": "change" },
      "allow": [],
      "deny": [],
      "require_approval": [
        {
          "action": "*",
          "approvers": ["platform-lead"],
          "timeout": null,
          "fallback": { "kind": "lowest_risk_alternative" }
        }
      ],
      "triggers": ["reindex", "migration", "schema-change", "destructive", "shard-consolidation", "downtime"],
      "required_fields": ["estimated_downtime", "rollback_plan", "approval_authority"],
      "severity": "high",
      "proposed_by": "parity-runner",
      "proposed_at": "2020-01-01T00:00:00Z",
      "active_from": "2020-01-01T00:00:00Z"
    },
    {
      "path": "change-control/future-scheduled",
      "version": 1,
      "situation": "Placeholder for a future-dated rollout (§1 active_from enforcement).",
      "situation_selector": { "kind": "eq", "key": "kind", "value": "change" },
      "allow": [],
      "deny": [{ "action": "tune_opensearch", "condition": "always" }],
      "require_approval": [],
      "triggers": [],
      "required_fields": [],
      "severity": "low",
      "proposed_by": "parity-runner",
      "proposed_at": "2020-01-01T00:00:00Z",
      "active_from": "2099-01-01T00:00:00Z"
    }
  ],
  "ratify": [
    {
      "path": "change-control/high-cost-change",
      "ratifier": "platform-lead",
      "reasoning": "Reviewed; matches change-control board policy. Approved for prod."
    },
    {
      "path": "change-control/future-scheduled",
      "ratifier": "platform-lead",
      "reasoning": "Ratified but gated by active_from=2099 — must NOT be consulted."
    }
  ],
  "change_proposals": [
    {
      "label": "Option A (no-op)",
      "proposal": {
        "action": "tune_opensearch",
        "agent_id": "agent/perf-tuner",
        "intent": "Leave heap + shard count alone. Score 3/10.",
        "preferred_option": "spec/A",
        "alternatives": ["spec/B", "spec/C"],
        "tokens": [],
        "attached_fields": {}
      },
      "expected_decision_kind": "no_policy_match"
    },
    {
      "label": "Option B (heap only, no reindex)",
      "proposal": {
        "action": "tune_opensearch",
        "agent_id": "agent/perf-tuner",
        "intent": "Bump heap to 1GB. No reindex. Score 7/10.",
        "preferred_option": "spec/B",
        "alternatives": ["spec/A", "spec/C"],
        "tokens": [],
        "attached_fields": {}
      },
      "expected_decision_kind": "no_policy_match"
    },
    {
      "label": "Option C (reindex — triggers high-cost-change policy)",
      "proposal": {
        "action": "tune_opensearch",
        "agent_id": "agent/perf-tuner",
        "intent": "Bump heap to 1GB + consolidate to single shard with reindex. Score 9/10.",
        "preferred_option": "spec/C",
        "alternatives": ["spec/A", "spec/B"],
        "tokens": ["reindex", "destructive"],
        "attached_fields": {}
      },
      "expected_decision_kind": "require_approval",
      "expected_matched_policy_prefix": "change-control/high-cost-change@"
    }
  ],
  "evaluate": [
    {
      "label": "situation not matched by any ratified+active policy",
      "situation": { "topic": "unrelated" },
      "action": "do_something_unrelated",
      "agent_id": "agent/x",
      "expected_decision_kind": "no_policy_match"
    }
  ],
  "extra_policies": [
    {
      "path": "tenant/acme/allow-do-thing",
      "version": 1,
      "situation": "tenant-scoped allow for the 0.7.5 §3 multi-tenant parity scenario",
      "situation_selector": { "kind": "eq", "key": "topic", "value": "tenant-parity" },
      "allow": [{ "action": "do_thing", "condition": null, "preconditions": [] }],
      "deny": [],
      "require_approval": [],
      "triggers": [],
      "required_fields": [],
      "severity": "low",
      "proposed_by": "parity-runner",
      "proposed_at": "2020-01-01T00:00:00Z",
      "active_from": "2020-01-01T00:00:00Z",
      "tenant_id": "acme"
    },
    {
      "path": "tenant/global/allow-do-thing",
      "version": 1,
      "situation": "global fallback allow (tenant_id omitted) for the 0.7.5 §3 parity scenario",
      "situation_selector": { "kind": "eq", "key": "topic", "value": "tenant-parity" },
      "allow": [{ "action": "do_thing", "condition": null, "preconditions": [] }],
      "deny": [],
      "require_approval": [],
      "triggers": [],
      "required_fields": [],
      "severity": "low",
      "proposed_by": "parity-runner",
      "proposed_at": "2020-01-01T00:00:00Z",
      "active_from": "2020-01-01T00:00:00Z"
    },
    {
      "path": "external/wasm-placeholder",
      "version": 1,
      "situation": "External-evaluator placeholder for the 0.7.5 §4 parity scenario. When no registry is installed the policy falls through the local path, but its empty allow/deny leaves it inert — runners with a WASM evaluator registered would consult the runner instead.",
      "situation_selector": { "kind": "eq", "key": "topic", "value": "external-parity" },
      "allow": [],
      "deny": [],
      "require_approval": [],
      "triggers": [],
      "required_fields": [],
      "severity": "low",
      "proposed_by": "parity-runner",
      "proposed_at": "2020-01-01T00:00:00Z",
      "active_from": "2020-01-01T00:00:00Z",
      "external_evaluator": {
        "kind": "wasm",
        "source": { "kind": "inline", "body": "(module)" }
      }
    }
  ],
  "ratify_extra": [
    { "path": "tenant/acme/allow-do-thing",   "ratifier": "platform-lead", "reasoning": "tenant-scoped" },
    { "path": "tenant/global/allow-do-thing", "ratifier": "platform-lead", "reasoning": "global fallback" },
    { "path": "external/wasm-placeholder",    "ratifier": "platform-lead", "reasoning": "external runner placeholder" }
  ],
  "tenant_evaluate": [
    {
      "label": "acme tenant sees its own tenant-scoped policy",
      "situation": { "topic": "tenant-parity" },
      "action": "do_thing",
      "agent_id": "parity-runner",
      "tenant_filter": "acme",
      "expected_decision_kind": "allow",
      "expected_matched_policy_prefix": "tenant/acme/allow-do-thing@"
    },
    {
      "label": "other tenant falls back to the global policy",
      "situation": { "topic": "tenant-parity" },
      "action": "do_thing",
      "agent_id": "parity-runner",
      "tenant_filter": "other",
      "expected_decision_kind": "allow",
      "expected_matched_policy_prefix": "tenant/global/allow-do-thing@"
    },
    {
      "label": "no filter sees both; first-match wins (implementation-defined)",
      "situation": { "topic": "tenant-parity" },
      "action": "do_thing",
      "agent_id": "parity-runner",
      "tenant_filter": null,
      "expected_decision_kind": "allow"
    }
  ],
  "external_evaluate": [
    {
      "label": "policy with unregistered external evaluator is skipped",
      "situation": { "topic": "external-parity" },
      "action": "do_thing",
      "agent_id": "parity-runner",
      "expected_decision_kind": "no_policy_match"
    }
  ],
  "taint_cases": [
    {
      "label": "warn-effect taint allows write but surfaces on check",
      "apply": {
        "path": "/parity/taint/warn-case",
        "name": "disk-pressure",
        "effect": "warn",
        "reason": "node under pressure",
        "severity": "medium",
        "propagate": true,
        "agent_id": "parity-runner"
      },
      "check": {
        "path": "/parity/taint/warn-case/child",
        "agent_id": "parity-runner",
        "confidence": 1.0
      },
      "expected": {
        "tainted": true,
        "can_write": true,
        "required_confidence": 0.0
      }
    },
    {
      "label": "block-effect taint denies write",
      "apply": {
        "path": "/parity/taint/block-case",
        "name": "crash-loop",
        "effect": "block",
        "reason": "spark-silver crash-looping",
        "severity": "critical",
        "propagate": true,
        "agent_id": "parity-runner"
      },
      "check": {
        "path": "/parity/taint/block-case/service",
        "agent_id": "parity-runner",
        "confidence": 1.0
      },
      "expected": {
        "tainted": true,
        "can_write": false
      }
    },
    {
      "label": "review-effect taint enforces confidence >= 0.9",
      "apply": {
        "path": "/parity/taint/review-case",
        "name": "needs-review",
        "effect": "review",
        "reason": "security review required",
        "severity": "high",
        "propagate": true,
        "agent_id": "parity-runner"
      },
      "check_low": {
        "path": "/parity/taint/review-case/target",
        "agent_id": "parity-runner",
        "confidence": 0.5
      },
      "check_high": {
        "path": "/parity/taint/review-case/target",
        "agent_id": "parity-runner",
        "confidence": 0.95
      },
      "expected_low_can_write": false,
      "expected_high_can_write": true,
      "expected_required_confidence": 0.9
    }
  ],
  "quarantine_case": {
    "label": "quarantine gates writes to authorized_agents only",
    "apply": {
      "path": "/parity/quarantine-case",
      "name": "security-review",
      "reason": "unauthorized-access pattern",
      "severity": "critical",
      "authorized_agents": ["agent/security"],
      "propagate": true,
      "agent_id": "agent/security"
    },
    "check_unauthorized": {
      "path": "/parity/quarantine-case/state",
      "agent_id": "parity-runner",
      "confidence": 1.0
    },
    "check_authorized": {
      "path": "/parity/quarantine-case/state",
      "agent_id": "agent/security",
      "confidence": 1.0
    },
    "expected_unauthorized_can_write": false,
    "expected_authorized_can_write": true
  }
}
