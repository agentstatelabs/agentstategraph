<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AgentStateGraph</AssemblyName>
    <RootNamespace>AgentStateGraph</RootNamespace>

    <PackageId>agentstatelabs.AgentStateGraph</PackageId>
    <Version>0.9.2</Version>
    <Authors>Craig Brown</Authors>
    <Company>AgentStateLabs, LLC</Company>
    <Description>
      AI-native versioned state store for intent-based systems. C# binding
      over the native Rust implementation via P/Invoke.
    </Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/agentstatelabs/agentstategraph</RepositoryUrl>
    <PackageProjectUrl>https://github.com/agentstatelabs/agentstategraph</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>agent;state;versioning;ai;ffi;rust</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!--
    Native FFI libraries, one per runtime identifier (RID). Build each with
    `cargo build -r -p agentstategraph-ffi` on the matching platform,
    then stage the output under:
      runtimes/win-x64/native/agentstategraph_ffi.dll
      runtimes/win-arm64/native/agentstategraph_ffi.dll
      runtimes/linux-x64/native/libagentstategraph_ffi.so
      runtimes/linux-arm64/native/libagentstategraph_ffi.so
      runtimes/osx-x64/native/libagentstategraph_ffi.dylib
      runtimes/osx-arm64/native/libagentstategraph_ffi.dylib
    NuGet auto-loads the RID-matched library at runtime, so `dotnet add
    package agentstatelabs.AgentStateGraph` works with no separate FFI build.
    The release workflow stages these before `dotnet pack`.
  -->
  <ItemGroup Condition="Exists('runtimes')">
    <Content Include="runtimes/**/native/*" Pack="true" PackagePath="runtimes">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
  </ItemGroup>
</Project>
