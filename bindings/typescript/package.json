{
  "name": "agentstategraph",
  "version": "0.9.8",
  "description": "AI-native versioned state store for intent-based systems",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentstatelabs/agentstategraph.git",
    "directory": "bindings/typescript"
  },
  "homepage": "https://agentstategraph.dev",
  "engines": {
    "node": ">=16"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "agentstategraph.*.node"
  ],
  "napi": {
    "binaryName": "agentstategraph",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3"
  },
  "scripts": {
    "build": "napi build --release --platform",
    "build-debug": "napi build --platform",
    "test": "node --test __test__/*.test.js"
  }
}
