#!/usr/bin/env bash
#
# Client-side pre-push gate — runs leak-scan on the commits about to be
# pushed and refuses the push if any BLOCK pattern is present.
#
# Install (per clone):   scripts/hooks/install.sh
# Bypass (discouraged):  git push --no-verify
#
# git passes "<local-ref> <local-sha> <remote-ref> <remote-sha>" on stdin.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
SCAN="${ROOT}/scripts/leak-scan.sh"
[ -x "$SCAN" ] || { echo "pre-push: ${SCAN} missing/executable" >&2; exit 1; }

ZERO=0000000000000000000000000000000000000000
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue          # branch deletion
  if [ "$remote_sha" = "$ZERO" ]; then
    range="$local_sha --not --remotes"            # new branch: only-new commits
  else
    range="${remote_sha}..${local_sha}"
  fi
  bash "$SCAN" --range "$range" || status=1
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: BLOCKED by leak-scan (see log above). Fix, or move content to the private repo." >&2
  exit 1
fi
exit 0
